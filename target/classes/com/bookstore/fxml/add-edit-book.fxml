<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- add-edit-book.fxml — Modal dialog for adding and editing a book -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bookstore.controller.AddEditBookController"
      spacing="0" prefWidth="560"
      styleClass="dialog-root">

    <!-- Dialog title bar -->
    <HBox alignment="CENTER_LEFT" styleClass="dialog-header">
        <Label fx:id="dialogTitleLabel" text="Add New Book" styleClass="dialog-title"/>
    </HBox>

    <!-- Scrollable form so "Other" + custom category never hides the footer buttons -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefViewportHeight="400" maxHeight="560" minViewportHeight="120"
                styleClass="dialog-form-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="20" styleClass="dialog-body">

        <!-- Row 1: Title (full width) -->
        <VBox spacing="6">
            <Label text="Title *" styleClass="field-label"/>
            <TextField fx:id="titleField" promptText="Enter book title"
                       styleClass="form-field"/>
        </VBox>

        <!-- Row 2: Author (full width) -->
        <VBox spacing="6">
            <Label text="Author *" styleClass="field-label"/>
            <TextField fx:id="authorField" promptText="Enter author name"
                       styleClass="form-field"/>
        </VBox>

        <!-- Row 3: Category (full width — custom name when "Other" is chosen) -->
        <VBox spacing="6">
            <Label text="Category *" styleClass="field-label"/>
            <ComboBox fx:id="categoryCombo" promptText="Select category"
                      maxWidth="Infinity" styleClass="form-combo"/>
            <VBox fx:id="customCategoryBox" spacing="6" managed="false" visible="false">
                <Label text="Your category *" styleClass="field-label"/>
                <TextField fx:id="customCategoryField" promptText="Type the category name…"
                           styleClass="form-field"/>
            </VBox>
        </VBox>

        <!-- Row 4: ISBN (full width so typed digits stay visible) -->
        <VBox spacing="6">
            <Label text="ISBN *" styleClass="field-label"/>
            <TextField fx:id="isbnField" promptText="e.g. 9780132350884"
                       styleClass="form-field"/>
        </VBox>

        <!-- Row 5: Price + Stock + Year -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Price ($) *" styleClass="field-label"/>
                <TextField fx:id="priceField" promptText="0.00"
                           styleClass="form-field"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Stock Qty *" styleClass="field-label"/>
                <TextField fx:id="stockField" promptText="0"
                           styleClass="form-field"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Pub. Year *" styleClass="field-label"/>
                <TextField fx:id="yearField" promptText="e.g. 2023"
                           styleClass="form-field"/>
            </VBox>
        </HBox>

        <!-- Row 6: Description -->
        <VBox spacing="6">
            <Label text="Description" styleClass="field-label"/>
            <TextArea fx:id="descriptionArea"
                      promptText="Brief description of the book…"
                      prefRowCount="3" wrapText="true"
                      styleClass="form-textarea"/>
        </VBox>

        <!-- Validation error message (hidden until triggered) -->
        <Label fx:id="errorLabel" text="" styleClass="error-label"
               wrapText="true"/>

        </VBox>
    </ScrollPane>

    <!-- Action buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <Button text="Reset" styleClass="btn-secondary" onAction="#handleReset"
                prefWidth="110"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"
                prefWidth="110"/>
        <Button fx:id="saveButton" text="Save Book" styleClass="btn-primary"
                onAction="#handleSave" prefWidth="140"
                defaultButton="true"/>
    </HBox>

</VBox>
