<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- books.fxml — Full book management page -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bookstore.controller.BooksController"
      spacing="0" styleClass="view-root">

    <!-- ── Page header ── -->
    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Book Library" styleClass="page-title"/>
            <Label fx:id="resultCountLabel" text="Loading..." styleClass="page-subtitle"/>
        </VBox>
        <Button text="＋  Add Book" styleClass="btn-primary" onAction="#openAddDialog"/>
    </HBox>

    <!-- ── Toolbar: search + filter + refresh ── -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">

        <!-- Search -->
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label text="🔍" styleClass="search-icon"/>
            <TextField fx:id="searchField"
                       promptText="Search by title, author, or ISBN…"
                       styleClass="search-field" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Category filter -->
        <ComboBox fx:id="categoryFilter"
                  promptText="All Categories"
                  prefWidth="180"
                  styleClass="filter-combo"/>

        <!-- Refresh -->
        <Button text="↺" styleClass="btn-icon" onAction="#handleRefresh"
                tooltip="Refresh"/>
    </HBox>

    <!-- ── Books table ── -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <TableView fx:id="booksTable" VBox.vgrow="ALWAYS" styleClass="dark-table">
            <columns>
                <TableColumn fx:id="colTitle"    text="TITLE"    prefWidth="220" minWidth="150"/>
                <TableColumn fx:id="colAuthor"   text="AUTHOR"   prefWidth="170" minWidth="120"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="120" minWidth="100"/>
                <TableColumn fx:id="colPrice"    text="PRICE"    prefWidth="90"  minWidth="70"/>
                <TableColumn fx:id="colStock"    text="STOCK"    prefWidth="80"  minWidth="60"/>
                <TableColumn fx:id="colIsbn"     text="ISBN"     prefWidth="140" minWidth="120"/>
                <TableColumn fx:id="colYear"     text="YEAR"     prefWidth="70"  minWidth="60"/>
                <TableColumn fx:id="colActions"  text="ACTIONS"  prefWidth="160" minWidth="140"
                             sortable="false" resizable="false"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="12">
                    <Label text="📭" style="-fx-font-size: 40px;"/>
                    <Label text="No books found" styleClass="table-placeholder"/>
                    <Label text="Try a different search or add a new book."
                           styleClass="text-muted"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
