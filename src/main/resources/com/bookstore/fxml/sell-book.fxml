<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bookstore.controller.SellBookController"
      spacing="0" prefWidth="420"
      styleClass="dialog-root">

    <HBox alignment="CENTER_LEFT" styleClass="dialog-header">
        <Label text="Sell Book" styleClass="dialog-title"/>
    </HBox>

    <VBox spacing="16" styleClass="dialog-body">
        <VBox spacing="4">
            <Label fx:id="bookTitleLabel" wrapText="true"
                   style="-fx-text-fill: #F0F6FC; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label fx:id="metaLabel" styleClass="text-muted" wrapText="true"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Quantity to sell *" styleClass="field-label"/>
            <TextField fx:id="quantityField" promptText="e.g. 1"
                       styleClass="form-field"/>
        </VBox>

        <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true"
               visible="false" managed="false"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel" prefWidth="100"/>
        <Button text="Confirm Sale" styleClass="btn-primary" onAction="#handleConfirm"
                prefWidth="130" defaultButton="true"/>
    </HBox>
</VBox>
